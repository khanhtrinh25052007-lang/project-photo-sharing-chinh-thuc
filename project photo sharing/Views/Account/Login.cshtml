@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Đăng nhập - PixelShare</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .login-box {
            background: white;
            padding: 30px;
            border-radius: 10px;
            border: 1px solid #ddd;
            width: 300px;
            text-align: center;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .btn-submit {
            width: 100%;
            padding: 10px;
            background-color: #4a90e2;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .error {
            color: red;
            font-size: 14px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="login-box">
        <h2 style="color: #4a90e2; margin-top: 0;">PixelShare</h2>
        <p>Đăng nhập để xem ảnh</p>

        @if (ViewBag.Error != null)
        {<div class="error">@ViewBag.Error</div>}

        <form action="@Url.Action("Login", "Account")" method="post">
            <input type="email" name="email" class="form-control" placeholder="Nhập Email" required />
            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
            <button type="submit" class="btn-submit">Đăng nhập</button>
        </form>

        <p style="font-size: 14px; margin-top: 20px;">Chưa có tài khoản? <a href="@Url.Action("Register", "Account")" style="color: #4a90e2;">Đăng ký ngay</a></p>
    </div>
</body>
</html>